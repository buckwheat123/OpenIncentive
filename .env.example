# Copy to .env (git-ignored) and fill in real values to enable live email sending.
# Without these, the platform runs in local outbox mode (writes data/outbox/*.html).

# --- SMTP (sending) ---
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USE_SSL=1
SMTP_USE_TLS=0
SMTP_USER=you@example.com
SMTP_PASSWORD=your_client_auth_code
SMTP_FROM=you@example.com

# --- POP3 (optional connection self-test) ---
POP3_HOST=pop.163.com
POP3_PORT=995
POP3_USE_SSL=1
